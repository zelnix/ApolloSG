{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./packages"
      ],
      "android": {
        "exclude": [
          "guarddog-expo-module"
        ]
      },
      "ios": {
        "exclude": [
          "guarddog-expo-module"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "apollo-security",
          "apollo-family-assist",
          "guarddog-expo-module"
        ]
      }
    }
  },
  "scripts": {
    "preinstall": "./scripts/cmd-guard.js --preinstall",
    "postinstall": "node scripts/eas-post-install.mjs",
    "start": "npx expo start",
    "security:preflight": "node scripts/security-preflight.mjs",
    "test:security": "node --test tests/securityConfig.test.ts",
    "test:boot": "node --test tests/securityBoot.test.ts",
    "test:platform": "node --test tests/platformCapability.test.ts",
    "test:adapter-contract": "node --test tests/adapterContract.test.ts",
    "test:evidence-sync": "node --test tests/enforcementEvidenceSync.test.ts",
    "test:gate2": "node --test tests/messageAnalysis.test.ts",
    "test:gate3": "node --test tests/gate3.test.ts",
    "test:gate4": "node --test tests/gate4.test.ts",
    "test:gate5": "node --test tests/gate5.test.ts",
    "test:gate6": "node --test tests/gate6.test.ts",
    "test:gate7": "node --test tests/gate7.test.ts",
    "test:gate8": "node --test tests/gate8.test.ts",
    "test:gate1": "node --test tests/gate1.test.ts",
    "test:share": "node --test tests/share.test.ts",
    "eas-build-pre-install": "node scripts/security-preflight.mjs",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "lint": "npx expo lint",
    "test:family": "node --test tests/familyWeekly.test.ts",
    "test:higgins": "node --test tests/higginsGreeting.test.ts",
    "test:fit": "node --test tests/theme-fit.test.ts",
    "test:phone-identity": "node --test tests/phoneIdentity.test.ts",
    "test:narration": "node --test tests/higginsNarration.test.ts",
    "test:truth": "node --test tests/protectionTruth.test.ts",
    "test:failure": "node --test tests/failureModes.test.ts",
    "test:higgins-checks": "node --test tests/higginsChecks.test.ts",
    "test:device-capabilities": "node --test tests/deviceCapabilities.test.ts",
    "verify:no-simulation": "node scripts/verify-no-simulation.mjs",
    "test:preview-isolation": "node --test tests/previewIsolation.test.ts",
    "test:wright-phase8": "node --test tests/wrightSemanticContract.test.ts tests/wrightSemanticRunner.test.ts tests/wrightPhase6.test.ts",
    "verify:wright-phase8": "yarn test:wright-phase8 && yarn tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@nandorojo/heroicons": "0.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/plugin-notification": "^2.3.3",
